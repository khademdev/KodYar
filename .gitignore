# خروجی‌های ساخت (build artifacts)
bin/*
!bin/.gitkeep
build/bin/

# فایل‌های سیستمی/ویرایشگر
.DS_Store
Thumbs.db

# ابزارهای ایجنت (نباید با سورس‌ها توزیع شود)
.freebuff/

# لاگ‌ها و باینری‌های محلی
*.log
*.exe
*.exe~
*.test
*.out

# توجه: frontend/wailsjs/ عمداً نادیده گرفته نمی‌شود — این فایل‌ها دستی
# نگهداری می‌شوند و ساخت با -skipbindings به آن‌ها تکیه دارد (منبع است، نه خروجی).

# باینری محلی لینوکس (خروجی go build / wails build روی لینوکس)
/kodyar

# وابستگی‌های نصب‌شدهٔ فرانت‌اند (تست مرورگری) — هرگز کامیت نمی‌شود
node_modules/
frontend/tests/test-results/
frontend/tests/playwright-report/

# فایل‌های محیطی/کلیدها — کلید API هرگز در مخزن نمی‌آید
.env
.env.*
!.env.example

# پیوست‌ها/بازمانده‌های ابزار محلی
.cloud-attachments/

# اسکرین‌شات‌های ابزار browser_screenshot (خروجی موقت، نه سورس)
screenshots/
